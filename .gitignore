# Environment
.env
.env.backup
.env.production
.env.testing

# Google credentials
storage/app/google-service-account.json
/auth.json

# Dependencies
/node_modules
/vendor

# Build artifacts
/public/build
/public/hot
/public/storage

# Filament published assets — regenerated by `php artisan filament:assets`,
# which filament:upgrade runs from composer's post-autoload-dump hook
/public/css/filament
/public/js/filament
/public/fonts/filament

# Laravel runtime
/storage/*.key
/storage/pail
*.log

# Testing
.phpunit.result.cache
/.phpunit.cache
*.sqlite

# IDE & editors
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed

# OS
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml

# AI tools (machine-specific config)
/.claude/
/.mcp.json
/opencode.json

# Boost-generated skill mirrors — the canonical source is .ai/skills, which is
# tracked. Boost copies it into each configured agent's skills dir on
# `php artisan boost:update`, alongside the skills it ships itself.
/.agents/
/.github/skills/

# PHP tools
.phpactor.json
/AGENTS.md
/CLAUDE.md
